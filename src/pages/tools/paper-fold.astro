---
import ToolLayout from '../../layouts/ToolLayout.astro';
import '../../styles/paper-fold.css';
import { journeyFoldLimit, milestoneFold } from '../../scripts/paper-fold/model';
import { JOURNEY_REFERENCES, MILESTONE_REFERENCES } from '../../scripts/paper-fold/references';
const milestoneLabels: Record<string,string> = {person:'人的身高',house:'房屋高度',earth:'地球直径',sun:'太阳直径',betelgeuse:'参宿四',solar:'海王星轨道','milky-way':'银河系',andromeda:'仙女座距离',laniakea:'超星系团','observable-universe':'可观测宇宙'};
const extraSources = [...new Map(JOURNEY_REFERENCES.filter(ref => ref.source).map(ref => [ref.source!.url, ref.source!])).values()];
---
<ToolLayout title="纸张折叠宇宙 · 一张纸，能长到多远？" description="从 0.1 毫米纸张出发，连续对折并平滑缩放，看指数增长如何越过人的身高、房屋、地球、太阳、红超巨星、太阳系行星轨道、银河系与星系间距离，直到可观测宇宙。默认纸张约 103 次折叠即可抵达，探索指数增长的理想数学模型。" currentSlug="paper-fold">
  <header class="pf-intro" slot="header"><div><span class="pf-eyebrow">EXPONENTIAL JOURNEY / 指数之旅</span><h1>一张纸，<em>能长到多远？</em></h1></div><p>每折一次，厚度翻倍。<br />从指尖的一张薄纸，慢慢折进宇宙。</p></header>
  <section class="pf-lab" id="paper-fold-lab" aria-label="纸张折叠宇宙实验" data-folds="0" data-playing="false" data-motion="false">
    <div class="pf-stage" id="pf-stage"><div class="pf-scene">
      <div class="pf-stage-top"><span><i></i> 一次折叠 · 两倍厚度</span><span id="pf-status" role="status">从一张纸开始</span></div>
      <div class="pf-readout"><div class="pf-count"><strong id="pf-count">0</strong><span>次对折<br /><small id="pf-limit">OF {journeyFoldLimit()}</small></span></div><div class="pf-thickness"><small>此刻的理论厚度</small><strong id="pf-thickness">0.1 mm</strong><span id="pf-scientific">1 × 10⁻⁴ m</span></div></div>
      <canvas id="pf-canvas" role="img" aria-label="一张纸的侧视图。下方控制可改变折叠次数，纸叠高度与参照物使用同一长度比例。">纸张厚度等于初始厚度乘以 2 的折叠次数次方。所有数值也在画布外提供。</canvas>
      <div class="pf-scale-key"><span class="pf-paper-dot"></span>纸叠厚度<span class="pf-reference-dot"></span>同尺参照<span class="pf-scale-annotation">宽度与纹理为示意</span></div>

      </div>
      <section class="pf-fold-detail" aria-label="整叠对折近景">
        <div class="pf-fold-detail-copy"><span class="pf-eyebrow">整叠一起折</span><strong id="pf-fold-detail-title">1 层，准备对折</strong><p id="pf-fold-detail-state">沿中线折起右半叠，所有层一起落下</p><small>动作示意 · 尺寸重新取景<br />层数很大时，纹理代表层组</small></div>
        <canvas id="pf-fold-detail-canvas" role="img" aria-label="整叠纸沿中线对折的动作示意，所有已有纸层同时折起。">整叠对折后宽度减半，厚度和层数翻倍。近景尺寸和纹理为示意，实际厚度比例见上方。</canvas>
      </section>
      <div class="pf-reference-context" aria-label="相邻尺度参照">
        <div class="pf-reference-heading"><span>沿途参照</span><span id="pf-reference-now">画面此刻 · 0.1 毫米</span></div>
        <div class="pf-reference-pair">
          <button type="button" id="pf-reference-previous" data-nearby="previous" aria-describedby="pf-previous-ratio pf-previous-placement"><span class="pf-reference-kicker">已越过 <small id="pf-previous-placement">同尺可见</small></span><strong id="pf-previous-name">一根头发</strong><span class="pf-reference-dimension" id="pf-previous-dimension">直径 0.07 毫米（示意）</span><span class="pf-reference-ratio" id="pf-previous-ratio">当前约为它的 1.43 倍</span></button>
          <button type="button" id="pf-reference-next" data-nearby="next" aria-describedby="pf-next-ratio pf-next-placement"><span class="pf-reference-kicker">正靠近 <small id="pf-next-placement">同尺可见</small></span><strong id="pf-next-name">一张卡片</strong><span class="pf-reference-dimension" id="pf-next-dimension">厚度 0.8 毫米（示意）</span><span class="pf-reference-ratio" id="pf-next-ratio">目标是当前的 8 倍</span></button>
        </div>
        <div class="pf-reference-progress" id="pf-reference-progress" aria-hidden="true"><i></i></div>
        <p>进度按翻倍计 · 点击可达参照跳转，画外仍显示倍数</p>
      </div>
    </div>
    <div class="pf-console">
      <div class="pf-actions"><button type="button" id="pf-play" class="pf-primary" aria-pressed="false"><span aria-hidden="true">▶</span> 开始折叠</button><button type="button" id="pf-step" aria-label="再折一次">+ 再折一次</button><button type="button" id="pf-reset" class="pf-reset">重置</button><label class="pf-speed" for="pf-speed">节奏<select id="pf-speed"><option value="1600">慢慢看</option><option value="1000" selected>标准</option><option value="500">快一点</option></select></label></div>
      <div class="pf-timeline-heading"><label for="pf-folds" id="pf-timeline-label">拖动，穿过 {journeyFoldLimit()} 次翻倍</label><output id="pf-folds-output" for="pf-folds">第 0 次</output></div>
      <input class="pf-fold-slider" id="pf-folds" type="range" min="0" max={journeyFoldLimit()} step="1" value="0" aria-label="折叠次数" />
      <div class="pf-ticks" id="pf-ticks" aria-hidden="true">{[0,20,40,60,80,journeyFoldLimit()].map(n => <span style={`left:${n/journeyFoldLimit()*100}%`}>{n}</span>)}</div>
      <div class="pf-milestones" aria-label="跳到尺度里程碑">
        {MILESTONE_REFERENCES.map(ref => <button type="button" data-milestone={ref.id}>
          <svg viewBox="0 0 24 24" aria-hidden="true">{ref.kind === 'distance' ? <><path d="M5 5v14m-3-14h6m-6 14h6M13 7l6 10M13 17l6-10"/><circle cx="16" cy="12" r="6"/></> : ref.kind === 'solar' || ref.kind === 'galaxy' ? <><ellipse cx="12" cy="12" rx="10" ry="5" transform="rotate(-30 12 12)"/><circle cx="12" cy="12" r="2"/></> : ref.kind === 'person' ? <><circle cx="12" cy="4" r="2"/><path d="M8 10l4-3 4 3M12 7v8m0-1-4 7m4-7 4 7"/></> : ref.kind === 'house' ? <path d="m3 11 9-8 9 8M6 9v12h12V9m-8 12v-7h4v7"/> : <><circle cx="12" cy="12" r="8"/><path d="M12 1v3m0 16v3M1 12h3m16 0h3"/></>}</svg>
          <span>{milestoneLabels[ref.id]}<small data-milestone-fold={ref.id}>{milestoneFold(ref.metres)} 次</small></span>
        </button>)}
      </div>
      <div class="pf-settings"><label for="pf-initial">换一张纸 <span><input id="pf-initial" type="number" min="0.01" max="1" step="0.01" value="0.1" inputmode="decimal" /> mm</span></label><p id="pf-input-help">初始厚度 0.01–1 mm · 修改会暂停</p><div class="pf-layer-count"><small>层数</small><span id="pf-layers">1</span><span id="pf-layer-power">= 2⁰</span></div></div>
      <p class="pf-motion-note" id="pf-motion-note" hidden>已跟随系统减少动态效果：折叠和尺度直接切换，自动播放需手动开始。</p>
    </div>
  </section>
  <div class="pf-explanation">
    <section class="pf-equation"><span class="pf-eyebrow">一个简单的规则</span><h2>增长，开始得很安静。</h2><div class="pf-formula" aria-label="厚度等于初始厚度乘以 2 的 n 次方"><span id="pf-formula-initial">0.1 mm</span><b>×</b><span>2<sup id="pf-formula-power">0</sup></span><b>=</b><span id="pf-formula-result">0.1 mm</span></div><p>这是指数增长：每增加一次对折，增加的是此前的全部厚度。时间轴的每一格都代表一次翻倍；画面用连续变化的对数相机缩放，让跨越几十个数量级的变化仍然看得见。</p></section>
    <section><span class="pf-eyebrow">先把现实说清楚</span><h2>思想实验，不是折纸挑战。</h2><p>这里假设纸张能无限延展、每次完美对半折叠，而且不压缩、没有空隙。真实纸张会受尺寸、材料、折痕和所需力量限制；“最多只能折 7 次”并不是普适定律。旅程在纸叠首次达到可观测宇宙的参考直径时结束：默认 0.1 mm 纸张需 103 次，允许的纸张范围对应 100–107 次。这只是数学模型的终点，不是现实可折叠次数。</p><p>动作近景展示整叠沿同一折痕翻转：折起的一半保留全部已有层，合拢后层数翻倍，再连续重新取景以展示下一折。近景宽厚为示意，层数很大时以有限层组表现，不宣称现实中仍能折动。上方纸叠的竖直厚度与参照物的高度、直径或距离共用长度比例尺，纸叠宽度和层纹只是示意。距离用竖直线段表示，端点、轨道点和横向排布为示意。珠峰从海平面量起；卡门线是约定的高度，不代表大气突然消失。动画中的过渡厚度用于平滑表现，数值面板始终显示选中整数次折叠的计算结果。</p></section>
  </div>
  <details class="pf-sources"><summary>尺度口径与数据来源</summary><div><p>人高 1.7 m、房屋高 10 m 是选定的生活参照，并非统计平均值。地球采用赤道直径 12,756 km，太阳采用直径 1,391,400 km，都是近似参考值。</p><p>本页的“太阳系尺度”特指海王星轨道的近似直径：约 60 AU。它不是太阳系的真实边界，也不是海王星本身的直径。太阳系还包括更远的天体。轨道图为俯视示意，行星点大小做了可见性放大。</p><p>新增的头发、卡片、米粒、网球、书和百米高楼也采用选定尺寸，并非统计平均值。空间站高度约 400 km，会随轨道调整；地月距离取中心间平均距离。木星轨道参照采用长轴约 10.4 AU。更远处穿插光行进指定时间的距离；光年是长度单位，不是时间。</p><p>太阳也是恒星。这里继续比较天狼星 A、大角星、毕宿五、心宿二、参宿四和大犬座 VY；它们的直径大于太阳。恒星尺寸会因距离、观测波段、模型和脉动而变化，所列为选定文献的近似值，不是“最大恒星”排行榜。半径以太阳半径为单位时，直径的倍数相同；参宿四取模型估计 764 倍（论文范围 +116/−62），大犬座 VY 取光球估计 1,420 ±120 倍，不把外围气体算成星体表面。</p><p>银河系参照为恒星盘直径约 10 万光年，不包括更大的晕结构。猎户座大星云、N44 与星团采用整个对象的近似跨度。仙女座与 M87 用的是距地球的距离，不是星系本身的直径。拉尼亚凯亚采用星系运动所定义区域的约 5.2 亿光年跨度，没有球形硬边界。所有轮廓均为本站绘制的示意图，未使用第三方图片。</p><p>终点是<strong>可观测宇宙</strong>：按 NASA 2025 年科普采用当前直径约 920 亿光年。这是考虑宇宙膨胀的当前距离尺度，不是把宇宙年龄约 138 亿年直接当成半径。更大的整个宇宙究竟有多大、有限还是无限，目前没有可靠答案；图中的虚线范围不是一堵实体边墙。</p><ul>{extraSources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}</ul><p>1 AU = 149,597,870,700 m；1 光年约为 9.4607 × 10¹⁵ m。大数长度保留适合阅读的有效数字；层数使用整数精确计算，避免大整数精度丢失。</p></div></details>
  <nav class="pf-related" aria-label="相关科学实验"><span>继续探索</span><a href="/tools/cosmic-scale/">宇宙尺度漫游 <span aria-hidden="true">↗</span></a><a href="/tools/zeno-race/">芝诺悖论追逐实验 <span aria-hidden="true">↗</span></a></nav>
  <noscript><p>交互折叠需要 JavaScript。默认 0.1 mm 纸张经过 n 次理想对折，厚度为 0.1 × 2ⁿ mm。</p></noscript>
</ToolLayout>
<script>import '../../scripts/paper-fold/main';</script>
