---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="图片格式互转"
  description="图片格式在线互转工具，支持多图批量 WebP、JPG、PNG、ICO 本地转换，下载保留原文件名。"
  currentSlug="image-convert"
>
  <h1 slot="header">图片格式互转</h1>
  <p class="intro">支持多图批量互转 WebP / JPG / PNG / ICO，本地下载，文件名保留原名并改后缀。</p>

  <div class="compress-workspace batch-workspace" id="convert-wrap">
    <div class="compress-panel">
      <div class="field-label">原图（可多选）</div>
      <label class="img-slot img-slot-upload" id="convert-drop">
        <input type="file" id="convert-file" accept="image/*,.ico" multiple />
        <span id="convert-placeholder">点击或拖拽上传，可多选</span>
      </label>
      <div class="batch-grid cols-1" id="convert-src-grid"></div>
      <div class="img-meta" id="convert-meta">—</div>
    </div>

    <div class="compress-panel compress-controls">
      <div>
        <label class="field-label" for="convert-format">输出格式</label>
        <select id="convert-format">
          <option value="image/webp">WebP</option>
          <option value="image/png">PNG</option>
          <option value="image/jpeg">JPG</option>
          <option value="image/x-icon">ICO</option>
        </select>
      </div>
      <div>
        <label class="field-label">质量 <span class="range-val" id="convert-quality-val">90%</span></label>
        <div class="range-row">
          <input type="range" id="convert-quality" min="10" max="100" value="90" />
        </div>
      </div>
      <div>
        <label class="field-label" for="ico-size">ICO 尺寸</label>
        <select id="ico-size">
          <option value="16">16×16</option>
          <option value="32" selected>32×32</option>
          <option value="48">48×48</option>
          <option value="64">64×64</option>
          <option value="128">128×128</option>
          <option value="256">256×256</option>
        </select>
      </div>
      <div class="btn-row compress-btn-row">
        <button class="btn" id="btn-convert" type="button">全部转换</button>
        <button class="btn btn-secondary" id="btn-convert-dl" type="button" hidden>批量下载</button>
        <button class="btn btn-secondary" id="btn-convert-clear" type="button" hidden>清空</button>
      </div>
      <div id="convert-msg"></div>
    </div>

    <div class="compress-panel">
      <div class="field-label">转换后（多图预览）</div>
      <div class="batch-grid cols-1" id="convert-out-grid">
        <span class="img-meta" style="grid-column:1/-1">等待转换</span>
      </div>
      <div class="img-meta" id="convert-out-meta">—</div>
    </div>
  </div>
</ToolLayout>

<script>
  import {
    canvasToBlob,
    extFromMime,
    fmtSize,
    gridColsClass,
    loadImageFromFile,
    outputName,
    revokeItemUrls,
    zipAndDownload,
    type BatchItem,
  } from '../../scripts/image-batch';

  const wrap = document.getElementById('convert-wrap')!;
  const fileInput = document.getElementById('convert-file') as HTMLInputElement;
  const drop = document.getElementById('convert-drop')!;
  const srcGrid = document.getElementById('convert-src-grid')!;
  const outGrid = document.getElementById('convert-out-grid')!;
  const meta = document.getElementById('convert-meta')!;
  const outMeta = document.getElementById('convert-out-meta')!;
  const format = document.getElementById('convert-format') as HTMLSelectElement;
  const quality = document.getElementById('convert-quality') as HTMLInputElement;
  const qualityVal = document.getElementById('convert-quality-val')!;
  const icoSize = document.getElementById('ico-size') as HTMLSelectElement;
  const btnDl = document.getElementById('btn-convert-dl') as HTMLButtonElement;
  const btnClear = document.getElementById('btn-convert-clear') as HTMLButtonElement;
  const msg = document.getElementById('convert-msg')!;

  let items: BatchItem[] = [];
  let activeId = '';

  function showMsg(text: string, type: 'error' | 'success') {
    msg.className = `msg ${type}`;
    msg.textContent = text;
  }

  async function makeIco(png: Blob, size: number) {
    const pngBytes = new Uint8Array(await png.arrayBuffer());
    const header = new ArrayBuffer(22);
    const view = new DataView(header);
    view.setUint16(0, 0, true);
    view.setUint16(2, 1, true);
    view.setUint16(4, 1, true);
    view.setUint8(6, size == 256 ? 0 : size);
    view.setUint8(7, size == 256 ? 0 : size);
    view.setUint8(8, 0);
    view.setUint8(9, 0);
    view.setUint16(10, 1, true);
    view.setUint16(12, 32, true);
    view.setUint32(14, pngBytes.length, true);
    view.setUint32(18, 22, true);
    return new Blob([header, pngBytes], { type: 'image/x-icon' });
  }

  function setGridClass(el: HTMLElement, n: number) {
    el.className = `batch-grid ${gridColsClass(n)}`;
  }

  function renderGrids() {
    wrap.classList.toggle('has-files', items.length > 0);
    setGridClass(srcGrid, items.length);
    setGridClass(outGrid, items.length || 1);

    srcGrid.innerHTML = items.map((it) => {
      const st = it.status == 'done' ? '完成' : it.status == 'error' ? '失败' : '待处理';
      const cls = [
        'batch-thumb',
        it.id == activeId ? 'is-active' : '',
        it.status == 'done' ? 'is-done' : '',
        it.status == 'error' ? 'is-error' : '',
      ].filter(Boolean).join(' ');
      return `<button type="button" class="${cls}" data-id="${it.id}">
        <img src="${it.srcUrl || ''}" alt="" />
        <span class="batch-thumb-st">${st}</span>
        <span class="batch-thumb-cap">${it.file.name}</span>
      </button>`;
    }).join('');

    const done = items.filter((i) => i.status == 'done' && i.previewUrl);
    if (!items.length) {
      outGrid.innerHTML = '<span class="img-meta" style="grid-column:1/-1">等待转换</span>';
    } else if (!done.length) {
      outGrid.innerHTML = '<span class="img-meta" style="grid-column:1/-1">处理中…</span>';
    } else {
      outGrid.innerHTML = items.map((it) => {
        if (it.status != 'done' || !it.previewUrl) {
          return `<div class="batch-thumb is-error" data-id="${it.id}">
            <span class="batch-thumb-st">${it.status == 'error' ? '失败' : '…'}</span>
            <span class="batch-thumb-cap">${it.file.name}</span>
          </div>`;
        }
        const isIco = format.value == 'image/x-icon';
        const cls = `batch-thumb is-done${it.id == activeId ? ' is-active' : ''}`;
        return `<button type="button" class="${cls}" data-id="${it.id}">
          ${isIco ? '<span class="batch-thumb-cap">ICO</span>' : `<img src="${it.previewUrl}" alt="" />`}
          <span class="batch-thumb-st">完成</span>
          <span class="batch-thumb-cap">${it.outName || it.file.name}</span>
        </button>`;
      }).join('');
    }

    meta.textContent = items.length ? `共 ${items.length} 张` : '—';
    const active = items.find((i) => i.id == activeId && i.status == 'done');
    outMeta.textContent = active?.blob
      ? `${active.outName} · ${fmtSize(active.blob.size)}`
      : (done.length ? `已完成 ${done.length}/${items.length}` : '—');
    btnClear.hidden = items.length == 0;
    btnDl.hidden = done.length == 0;
  }

  async function convertOne(it: BatchItem) {
    const img = await loadImageFromFile(it.file);
    const toIco = format.value == 'image/x-icon';
    const size = toIco ? Number(icoSize.value) : Math.max(img.width, img.height);
    const canvas = document.createElement('canvas');
    canvas.width = toIco ? size : img.width;
    canvas.height = toIco ? size : img.height;
    const ctx = canvas.getContext('2d')!;
    if (format.value == 'image/jpeg') {
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
    if (toIco) {
      const ratio = Math.min(size / img.width, size / img.height);
      const w = Math.round(img.width * ratio);
      const h = Math.round(img.height * ratio);
      ctx.drawImage(img, (size - w) / 2, (size - h) / 2, w, h);
    } else {
      ctx.drawImage(img, 0, 0);
    }
    const q = Number(quality.value) / 100;
    const ext = extFromMime(format.value);
    const png = await canvasToBlob(canvas, 'image/png', q);
    const blob = toIco ? await makeIco(png, size) : await canvasToBlob(canvas, format.value, q);
    if (it.previewUrl) URL.revokeObjectURL(it.previewUrl);
    it.blob = blob;
    it.outName = outputName(it.file.name, ext);
    it.previewUrl = URL.createObjectURL(blob);
    it.status = 'done';
  }

  async function convertAll() {
    if (!items.length) {
      showMsg('请先上传图片', 'error');
      return;
    }
    showMsg('转换中…', 'success');
    for (const it of items) {
      try {
        await convertOne(it);
      } catch {
        it.status = 'error';
      }
      renderGrids();
    }
    if (!activeId || !items.find((i) => i.id == activeId && i.status == 'done')) {
      activeId = items.find((i) => i.status == 'done')?.id || '';
    }
    renderGrids();
    const ok = items.filter((i) => i.status == 'done').length;
    showMsg(`完成 ${ok}/${items.length}`, ok ? 'success' : 'error');
  }

  function addFiles(files: FileList | File[]) {
    const arr = Array.from(files).filter((f) => f.type.startsWith('image/') || /\.ico$/i.test(f.name));
    for (const file of arr) {
      items.push({
        id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
        file,
        status: 'pending',
        srcUrl: URL.createObjectURL(file),
      });
    }
    if (!activeId && items.length) activeId = items[0].id;
    renderGrids();
    convertAll();
  }

  function onGridClick(e: Event) {
    const btn = (e.target as HTMLElement).closest('[data-id]') as HTMLElement | null;
    if (!btn?.dataset.id) return;
    activeId = btn.dataset.id;
    renderGrids();
  }
  srcGrid.addEventListener('click', onGridClick);
  outGrid.addEventListener('click', onGridClick);

  fileInput.addEventListener('change', () => {
    if (fileInput.files?.length) addFiles(fileInput.files);
    fileInput.value = '';
  });
  drop.addEventListener('dragover', (e) => e.preventDefault());
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer?.files?.length) addFiles(e.dataTransfer.files);
  });
  quality.addEventListener('input', () => { qualityVal.textContent = `${quality.value}%`; });
  document.getElementById('btn-convert')!.addEventListener('click', convertAll);
  format.addEventListener('change', convertAll);
  icoSize.addEventListener('change', convertAll);
  btnDl.addEventListener('click', async () => {
    const done = items.filter((i) => i.status == 'done' && i.blob && i.outName)
      .map((i) => ({ name: i.outName!, blob: i.blob! }));
    await zipAndDownload(done, 'converted-images.zip');
  });
  btnClear.addEventListener('click', () => {
    items.forEach(revokeItemUrls);
    items = [];
    activeId = '';
    renderGrids();
    msg.textContent = '';
    msg.className = '';
  });
</script>
