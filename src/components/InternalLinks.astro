---
import tools from '../data/tools.json';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const related = tools.filter((t) => t.slug != currentSlug).slice(0, 4);

import { toolHref } from '../lib/urls';
---

<div class="related-links">
  {related.map((t) => (
    <a href={toolHref(t)}>{t.name}</a>
  ))}
</div>
