---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="图片文字识别 OCR"
  description="免费在线图片与扫描 PDF 文字识别，支持简体中文、繁体中文和英文；浏览器本地 OCR，不上传文档。"
  currentSlug="image-ocr"
>
  <h1 slot="header">图片文字识别 OCR</h1>
  <p class="intro">识别图片或扫描 PDF 中的印刷文字，支持中英文；文件留在浏览器内处理。</p>

  <div class="tool-panel ocr-control-panel">
    <label class="ocr-drop" id="ocr-drop">
      <input
        type="file"
        id="ocr-file"
        accept="image/png,image/jpeg,image/webp,image/bmp,.png,.jpg,.jpeg,.webp,.bmp,application/pdf,.pdf"
      />
      <span class="ocr-drop-copy">
        <strong id="ocr-file-name">点击或拖入图片 / PDF</strong>
        <small id="ocr-file-hint">支持 PNG、JPG、WebP、BMP 和 PDF，最大 30MB</small>
      </span>
    </label>

    <div class="ocr-settings">
      <label for="ocr-language">
        <span>识别语言</span>
        <select id="ocr-language">
          <option value="chi_sim+eng">简体中文 + 英文</option>
          <option value="chi_tra+eng">繁体中文 + 英文</option>
          <option value="eng">仅英文</option>
        </select>
      </label>
      <label for="ocr-pdf-mode">
        <span>PDF 文字策略</span>
        <select id="ocr-pdf-mode">
          <option value="auto">自动：优先内嵌文字</option>
          <option value="force">强制 OCR 每一页</option>
        </select>
      </label>
      <p>
        首次识别会联网下载 OCR 引擎与所选语言包，随后由浏览器缓存；文档本身不会上传。扫描件若带有不完整的隐藏文字层，请选择“强制 OCR”。
      </p>
    </div>

    <div class="btn-row">
      <button type="button" class="btn" id="ocr-start" disabled>开始识别</button>
      <button type="button" class="btn btn-secondary" id="ocr-cancel" hidden>停止</button>
      <button type="button" class="btn btn-secondary" id="ocr-clear" disabled>清空</button>
    </div>

    <div class="ocr-progress" id="ocr-progress-wrap" hidden>
      <div class="ocr-progress-label">
        <span id="ocr-status">准备中…</span>
        <span id="ocr-percent">0%</span>
      </div>
      <progress id="ocr-progress" max="1" value="0"></progress>
    </div>
    <div id="ocr-message" aria-live="polite"></div>
  </div>

  <section class="ocr-workspace" id="ocr-workspace" hidden aria-label="识别结果">
    <div class="ocr-pane ocr-preview-pane">
      <div class="ocr-pane-head">
        <strong>原稿预览</strong>
        <div class="ocr-page-tools">
          <button type="button" id="ocr-prev" aria-label="上一页">‹</button>
          <span id="ocr-page-label">1 / 1</span>
          <button type="button" id="ocr-next" aria-label="下一页">›</button>
        </div>
      </div>
      <div class="ocr-preview-stage">
        <div class="ocr-preview-image-wrap">
          <img id="ocr-preview" alt="待识别文件预览" />
          <canvas id="ocr-overlay" aria-hidden="true"></canvas>
        </div>
      </div>
      <div class="ocr-preview-foot">
        <span id="ocr-page-stats">—</span>
        <label class="ocr-box-toggle">
          <input type="checkbox" id="ocr-show-boxes" checked />
          显示识别区域
        </label>
      </div>
    </div>

    <div class="ocr-pane ocr-result-pane">
      <div class="ocr-pane-head">
        <strong>识别结果</strong>
        <span id="ocr-result-stats">—</span>
      </div>
      <textarea
        id="ocr-output"
        readonly
        spellcheck="false"
        aria-label="OCR 识别结果"
        placeholder="识别结果会显示在这里"
      ></textarea>
      <div class="btn-row">
        <button type="button" class="btn" id="ocr-copy">复制文字</button>
        <button type="button" class="btn btn-secondary" id="ocr-download">下载 TXT</button>
      </div>
    </div>
  </section>

  <section class="section ocr-notes">
    <h2>适合识别什么</h2>
    <p>适合截图、书页、票据和扫描 PDF 中的印刷文字。数字版 PDF 会优先读取其内嵌文本，扫描页才调用 OCR，速度和准确率通常更好。</p>
    <h2>与版面级 OCR 的区别</h2>
    <p>这是浏览器端轻量 OCR，可输出纯文本并标出识别区域，但不会重建复杂表格、公式或多栏 Markdown。合同、财务和医疗资料请务必对照原件复核。</p>
    <p class="field-hint">
      PDF 超过 20 页？可先用 <a href="/tools/pdf-split">PDF 拆分</a>；图片方向或清晰度不理想时，可先用
      <a href="/tools/image-resize">图片改尺寸</a> 处理。
    </p>
  </section>
</ToolLayout>

<style>
  .ocr-control-panel {
    padding: 16px;
  }

  .ocr-workspace[hidden],
  .ocr-progress[hidden] {
    display: none !important;
  }

  .ocr-drop {
    position: relative;
    display: grid !important;
    min-height: 116px;
    margin: 0 !important;
    place-items: center;
    overflow: hidden;
    border: 1.5px dashed var(--border);
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--bg), #fff);
    text-align: center;
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }

  .ocr-drop:hover,
  .ocr-drop.is-dragging {
    border-color: var(--primary);
    background: var(--primary-subtle);
  }

  .ocr-drop.has-file {
    min-height: 82px;
    border-style: solid;
  }

  .ocr-drop input[type='file'] {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    opacity: 0;
    cursor: pointer;
  }

  .ocr-drop-copy {
    display: grid;
    gap: 5px;
    padding: 18px;
    pointer-events: none;
  }

  .ocr-drop-copy strong {
    color: var(--text);
    font-size: 0.95rem;
  }

  .ocr-drop-copy small {
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 400;
  }

  .ocr-settings {
    display: grid;
    grid-template-columns: repeat(2, minmax(210px, 280px)) minmax(260px, 1fr);
    gap: 14px 18px;
    align-items: end;
    margin-top: 14px;
  }

  .ocr-settings label {
    margin: 0;
  }

  .ocr-settings label span {
    display: block;
    margin-bottom: 7px;
  }

  .ocr-settings select {
    margin: 0;
  }

  .ocr-settings p {
    margin: 0 0 2px;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .ocr-progress {
    margin-top: 14px;
  }

  .ocr-progress-label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .ocr-progress progress {
    display: block;
    width: 100%;
    height: 8px;
    overflow: hidden;
    border: 0;
    border-radius: 999px;
    background: var(--border);
    accent-color: var(--primary);
  }

  .ocr-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px;
    margin-bottom: 22px;
  }

  .ocr-pane {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .ocr-pane-head {
    display: flex;
    min-height: 48px;
    padding: 10px 13px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    font-size: 0.82rem;
  }

  .ocr-pane-head > span {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .ocr-page-tools {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.74rem;
  }

  .ocr-page-tools button {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    color: var(--text);
    cursor: pointer;
    font-size: 1.1rem;
  }

  .ocr-page-tools button:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }

  .ocr-preview-stage {
    display: grid;
    min-height: 480px;
    max-height: 680px;
    padding: 14px;
    place-items: center;
    overflow: auto;
    background:
      linear-gradient(45deg, #eee 25%, transparent 25%),
      linear-gradient(-45deg, #eee 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #eee 75%),
      linear-gradient(-45deg, transparent 75%, #eee 75%), #f8f8f8;
    background-position: 0 0, 0 6px, 6px -6px, -6px 0;
    background-size: 12px 12px;
  }

  .ocr-preview-image-wrap {
    position: relative;
    width: fit-content;
    max-width: 100%;
    line-height: 0;
    box-shadow: 0 4px 18px rgba(26, 24, 20, 0.14);
  }

  .ocr-preview-image-wrap img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 640px;
    background: #fff;
  }

  .ocr-preview-image-wrap canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .ocr-preview-foot {
    display: flex;
    min-height: 44px;
    padding: 9px 13px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.74rem;
  }

  .ocr-box-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    cursor: pointer;
  }

  .ocr-box-toggle input {
    margin: 0;
  }

  .ocr-result-pane {
    display: flex;
    min-height: 574px;
    flex-direction: column;
  }

  .ocr-result-pane textarea {
    width: 100%;
    min-height: 480px;
    flex: 1;
    padding: 14px;
    resize: vertical;
    border: 0;
    outline: 0;
    background: #fff;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .ocr-result-pane .btn-row {
    margin: 0;
    padding: 10px 13px;
    border-top: 1px solid var(--border);
  }

  .ocr-notes {
    max-width: 860px;
  }

  .ocr-notes h2 {
    margin: 22px 0 7px;
    font-size: 1.05rem;
  }

  .ocr-notes p:not(.field-hint) {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .btn:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  @media (max-width: 860px) {
    .ocr-settings,
    .ocr-workspace {
      grid-template-columns: 1fr;
    }

    .ocr-preview-stage {
      min-height: 320px;
    }

    .ocr-result-pane {
      min-height: 480px;
    }

    .ocr-result-pane textarea {
      min-height: 380px;
    }
  }

  @media (max-width: 520px) {
    .ocr-control-panel {
      padding: 12px;
    }

    .ocr-preview-foot {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<script>
  import { createWorker, OEM, PSM } from 'tesseract.js';
  import tesseractWorkerUrl from 'tesseract.js/dist/worker.min.js?url';
  import { GlobalWorkerOptions, getDocument } from 'pdfjs-dist/legacy/build/pdf.mjs';
  import pdfWorkerUrl from 'pdfjs-dist/legacy/build/pdf.worker.min.mjs?url';

  GlobalWorkerOptions.workerSrc = pdfWorkerUrl;

  const MAX_FILE_BYTES = 30 * 1024 * 1024;
  const MAX_PDF_PAGES = 20;
  const MAX_IMAGE_PIXELS = 25_000_000;
  const MAX_RENDER_PIXELS = 5_000_000;
  const MIN_NATIVE_TEXT = 15;

  type Box = { x0: number; y0: number; x1: number; y1: number };
  type PageResult = {
    page: number;
    text: string;
    confidence: number | null;
    boxes: { bbox: Box; confidence: number }[];
    previewUrl: string;
    width: number;
    height: number;
    source: 'ocr' | 'embedded';
  };

  class CancelledError extends Error {}
  const CANCEL_TOKEN = Symbol('ocr-cancelled');

  const fileInput = document.getElementById('ocr-file') as HTMLInputElement;
  const drop = document.getElementById('ocr-drop')!;
  const fileName = document.getElementById('ocr-file-name')!;
  const fileHint = document.getElementById('ocr-file-hint')!;
  const language = document.getElementById('ocr-language') as HTMLSelectElement;
  const pdfMode = document.getElementById('ocr-pdf-mode') as HTMLSelectElement;
  const startBtn = document.getElementById('ocr-start') as HTMLButtonElement;
  const cancelBtn = document.getElementById('ocr-cancel') as HTMLButtonElement;
  const clearBtn = document.getElementById('ocr-clear') as HTMLButtonElement;
  const progressWrap = document.getElementById('ocr-progress-wrap')!;
  const progress = document.getElementById('ocr-progress') as HTMLProgressElement;
  const status = document.getElementById('ocr-status')!;
  const percent = document.getElementById('ocr-percent')!;
  const message = document.getElementById('ocr-message')!;
  const workspace = document.getElementById('ocr-workspace')!;
  const preview = document.getElementById('ocr-preview') as HTMLImageElement;
  const overlay = document.getElementById('ocr-overlay') as HTMLCanvasElement;
  const pageLabel = document.getElementById('ocr-page-label')!;
  const pageStats = document.getElementById('ocr-page-stats')!;
  const resultStats = document.getElementById('ocr-result-stats')!;
  const prevBtn = document.getElementById('ocr-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('ocr-next') as HTMLButtonElement;
  const showBoxes = document.getElementById('ocr-show-boxes') as HTMLInputElement;
  const output = document.getElementById('ocr-output') as HTMLTextAreaElement;
  const copyBtn = document.getElementById('ocr-copy') as HTMLButtonElement;
  const downloadBtn = document.getElementById('ocr-download') as HTMLButtonElement;

  let selectedFile: File | null = null;
  let results: PageResult[] = [];
  let activePage = 0;
  let busy = false;
  let cancelled = false;
  let worker: Awaited<ReturnType<typeof createWorker>> | null = null;
  let workerLanguage = '';
  let runningPage = 0;
  let runningTotal = 1;
  let cancelSignal: Promise<typeof CANCEL_TOKEN> | null = null;
  let resolveCancel: (() => void) | null = null;

  const STATUS_LABELS: Record<string, string> = {
    'loading tesseract core': '下载 OCR 引擎',
    'initializing tesseract': '初始化 OCR 引擎',
    'loading language traineddata': '下载语言包',
    'initializing api': '加载语言模型',
    'recognizing text': '识别文字',
  };

  function formatSize(bytes: number) {
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / 1024 / 1024).toFixed(2)} MB`;
  }

  function safeStem(name: string) {
    return name.replace(/\.[^.]+$/, '').replace(/[\\/:*?"<>|]+/g, '-').trim() || 'ocr-result';
  }

  function isPdf(file: File) {
    return file.type == 'application/pdf' || /\.pdf$/i.test(file.name);
  }

  function isSupportedImage(file: File) {
    return /^(image\/(png|jpeg|webp|bmp))$/i.test(file.type)
      || /\.(png|jpe?g|webp|bmp)$/i.test(file.name);
  }

  function setMessage(text: string, ok = false) {
    message.className = text ? (ok ? 'msg success' : 'msg error') : '';
    message.textContent = text;
  }

  function setProgress(value: number, label: string) {
    const safe = Math.max(0, Math.min(1, Number.isFinite(value) ? value : 0));
    progress.value = safe;
    status.textContent = label;
    percent.textContent = `${Math.round(safe * 100)}%`;
  }

  function updateButtons() {
    startBtn.disabled = busy || !selectedFile;
    clearBtn.disabled = busy || !selectedFile;
    language.disabled = busy;
    pdfMode.disabled = busy;
    cancelBtn.hidden = !busy;
  }

  function beginCancelScope() {
    cancelSignal = new Promise((resolve) => {
      resolveCancel = () => resolve(CANCEL_TOKEN);
    });
  }

  async function withCancellation<T>(task: Promise<T>) {
    const signal = cancelSignal;
    if (!signal) return task;
    const result = await Promise.race([task, signal]);
    if (result === CANCEL_TOKEN) throw new CancelledError();
    return result as T;
  }

  function revokeResults() {
    for (const result of results) URL.revokeObjectURL(result.previewUrl);
    results = [];
    activePage = 0;
    workspace.hidden = true;
    preview.removeAttribute('src');
    output.value = '';
    overlay.width = 1;
    overlay.height = 1;
    overlay.hidden = true;
  }

  async function terminateWorker() {
    const current = worker;
    worker = null;
    workerLanguage = '';
    if (current) await current.terminate().catch(() => {});
  }

  function clearFile() {
    selectedFile = null;
    fileInput.value = '';
    fileName.textContent = '点击或拖入图片 / PDF';
    fileHint.textContent = '支持 PNG、JPG、WebP、BMP 和 PDF，最大 30MB';
    drop.classList.remove('has-file');
    progressWrap.hidden = true;
    revokeResults();
    setMessage('');
    updateButtons();
  }

  function chooseFile(file: File | null) {
    if (!file || busy) return;
    revokeResults();
    setMessage('');
    progressWrap.hidden = true;
    selectedFile = null;
    fileName.textContent = '点击或拖入图片 / PDF';
    fileHint.textContent = '支持 PNG、JPG、WebP、BMP 和 PDF，最大 30MB';
    drop.classList.remove('has-file');

    if (!isPdf(file) && !isSupportedImage(file)) {
      fileInput.value = '';
      setMessage('暂不支持这个格式，请选择 PNG、JPG、WebP、BMP 或 PDF');
      updateButtons();
      return;
    }
    if (file.size > MAX_FILE_BYTES) {
      fileInput.value = '';
      setMessage('文件超过 30MB，请压缩或拆分后再试');
      updateButtons();
      return;
    }

    selectedFile = file;
    fileName.textContent = file.name;
    fileHint.textContent = `${isPdf(file) ? 'PDF 文档' : '图片'} · ${formatSize(file.size)} · 点击可更换`;
    drop.classList.add('has-file');
    updateButtons();
  }

  function imageDimensions(file: File) {
    return new Promise<{ width: number; height: number }>((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const image = new Image();
      image.onload = () => {
        URL.revokeObjectURL(url);
        resolve({ width: image.naturalWidth, height: image.naturalHeight });
      };
      image.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error('浏览器无法读取这张图片'));
      };
      image.src = url;
    });
  }

  function canvasBlob(canvas: HTMLCanvasElement) {
    return new Promise<Blob>((resolve, reject) => {
      canvas.toBlob((blob) => {
        if (blob) resolve(blob);
        else reject(new Error('无法生成 PDF 页面预览'));
      }, 'image/jpeg', 0.92);
    });
  }

  function textFromPdfItems(items: unknown[]) {
    let text = '';
    for (const item of items) {
      if (!item || typeof item != 'object' || !('str' in item)) continue;
      const row = item as { str: string; hasEOL?: boolean };
      text += row.str;
      text += row.hasEOL ? '\n' : ' ';
    }
    return text.replace(/[ \t]+\n/g, '\n').replace(/[ \t]{2,}/g, ' ').trim();
  }

  async function ensureWorker(lang: string) {
    if (worker && workerLanguage == lang) return worker;
    await terminateWorker();
    setProgress(Math.max(progress.value, 0.01), '准备 OCR 引擎');
    const creatingWorker = createWorker(lang.split('+'), OEM.LSTM_ONLY, {
      workerPath: tesseractWorkerUrl,
      logger: (event) => {
        if (!busy) return;
        const label = STATUS_LABELS[event.status] || event.status;
        const recognizing = event.status == 'recognizing text';
        const pagePart = recognizing ? event.progress : Math.min(event.progress * 0.12, 0.1);
        const overall = (runningPage + pagePart) / runningTotal;
        setProgress(overall, `${label}${runningTotal > 1 ? ` · 第 ${runningPage + 1}/${runningTotal} 页` : ''}`);
      },
    });
    try {
      worker = await withCancellation(creatingWorker);
    } catch (error) {
      if (cancelled) void creatingWorker.then((created) => created.terminate()).catch(() => {});
      throw error;
    }
    workerLanguage = lang;
    await withCancellation(worker.setParameters({
      tessedit_pageseg_mode: PSM.AUTO,
      preserve_interword_spaces: '1',
      user_defined_dpi: '300',
    }));
    return worker;
  }

  function compactBoxes(blocks: { bbox: Box; confidence: number }[] | null | undefined) {
    return (blocks || [])
      .filter((block) => block.bbox && block.confidence >= 10)
      .map((block) => ({
        bbox: {
          x0: Number(block.bbox.x0) || 0,
          y0: Number(block.bbox.y0) || 0,
          x1: Number(block.bbox.x1) || 0,
          y1: Number(block.bbox.y1) || 0,
        },
        confidence: Number(block.confidence) || 0,
      }));
  }

  async function recognizeSource(source: File | HTMLCanvasElement, page: number, previewUrl: string, width: number, height: number) {
    const activeWorker = await ensureWorker(language.value);
    if (cancelled) throw new CancelledError();
    const recognized = await withCancellation(activeWorker.recognize(
      source,
      { rotateAuto: true },
      { text: true, blocks: true },
      `page-${page}`,
    ));
    if (cancelled) throw new CancelledError();
    return {
      page,
      text: recognized.data.text.trim(),
      confidence: recognized.data.confidence,
      boxes: compactBoxes(recognized.data.blocks),
      previewUrl,
      width,
      height,
      source: 'ocr' as const,
    };
  }

  async function processImage(file: File) {
    const dimensions = await withCancellation(imageDimensions(file));
    if (dimensions.width * dimensions.height > MAX_IMAGE_PIXELS) {
      throw new Error('图片像素超过 2500 万，请先缩小尺寸后再识别');
    }
    const previewUrl = URL.createObjectURL(file);
    runningPage = 0;
    runningTotal = 1;
    try {
      results.push(await recognizeSource(file, 1, previewUrl, dimensions.width, dimensions.height));
    } catch (error) {
      URL.revokeObjectURL(previewUrl);
      throw error;
    }
  }

  async function processPdf(file: File) {
    setProgress(0.01, '读取 PDF');
    const loading = getDocument({
      data: new Uint8Array(await withCancellation(file.arrayBuffer())),
      maxImageSize: MAX_IMAGE_PIXELS,
    });
    try {
      const pdf = await withCancellation(loading.promise);
      if (pdf.numPages > MAX_PDF_PAGES) {
        throw new Error(`PDF 共 ${pdf.numPages} 页，单次最多识别 ${MAX_PDF_PAGES} 页，请先拆分`);
      }
      runningTotal = pdf.numPages;

      for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber++) {
        if (cancelled) throw new CancelledError();
        runningPage = pageNumber - 1;
        setProgress(runningPage / runningTotal, `准备第 ${pageNumber}/${runningTotal} 页`);

        const page = await withCancellation(pdf.getPage(pageNumber));
        const content = await withCancellation(page.getTextContent());
        const nativeText = textFromPdfItems(content.items);
        const baseViewport = page.getViewport({ scale: 1 });
        const scale = Math.min(2.2, Math.sqrt(MAX_RENDER_PIXELS / (baseViewport.width * baseViewport.height)));
        const viewport = page.getViewport({ scale });
        const canvas = document.createElement('canvas');
        canvas.width = Math.max(1, Math.floor(viewport.width));
        canvas.height = Math.max(1, Math.floor(viewport.height));
        const context = canvas.getContext('2d', { alpha: false });
        if (!context) throw new Error('浏览器无法创建 PDF 画布');
        const renderTask = page.render({ canvas, canvasContext: context, viewport, background: '#ffffff' });
        await withCancellation(renderTask.promise);

        const previewBlob = await withCancellation(canvasBlob(canvas));
        const previewUrl = URL.createObjectURL(previewBlob);
        try {
          if (pdfMode.value != 'force' && nativeText.replace(/\s/g, '').length >= MIN_NATIVE_TEXT) {
            results.push({
              page: pageNumber,
              text: nativeText,
              confidence: null,
              boxes: [],
              previewUrl,
              width: canvas.width,
              height: canvas.height,
              source: 'embedded',
            });
            setProgress(pageNumber / runningTotal, `已读取第 ${pageNumber}/${runningTotal} 页内嵌文本`);
          } else {
            results.push(await recognizeSource(canvas, pageNumber, previewUrl, canvas.width, canvas.height));
          }
        } catch (error) {
          URL.revokeObjectURL(previewUrl);
          throw error;
        } finally {
          page.cleanup();
          canvas.width = 1;
          canvas.height = 1;
        }
      }
    } finally {
      await loading.destroy().catch(() => {});
    }
  }

  function combinedText() {
    if (results.length <= 1) return results[0]?.text || '';
    return results.map((result) => `--- 第 ${result.page} 页 ---\n${result.text}`).join('\n\n');
  }

  function drawBoxes() {
    const result = results[activePage];
    const context = overlay.getContext('2d');
    if (!result || !context) return;
    overlay.width = result.width;
    overlay.height = result.height;
    context.clearRect(0, 0, overlay.width, overlay.height);
    overlay.hidden = !showBoxes.checked || result.boxes.length == 0;
    if (overlay.hidden) return;

    context.lineWidth = Math.max(2, Math.round(Math.min(result.width, result.height) / 500));
    for (const box of result.boxes) {
      const { x0, y0, x1, y1 } = box.bbox;
      context.strokeStyle = box.confidence >= 70 ? 'rgba(31, 111, 235, 0.82)' : 'rgba(217, 119, 6, 0.82)';
      context.fillStyle = box.confidence >= 70 ? 'rgba(31, 111, 235, 0.06)' : 'rgba(217, 119, 6, 0.06)';
      context.fillRect(x0, y0, Math.max(0, x1 - x0), Math.max(0, y1 - y0));
      context.strokeRect(x0, y0, Math.max(0, x1 - x0), Math.max(0, y1 - y0));
    }
  }

  function renderActivePage() {
    const result = results[activePage];
    if (!result) return;
    pageLabel.textContent = `${activePage + 1} / ${results.length}`;
    prevBtn.disabled = activePage == 0;
    nextBtn.disabled = activePage == results.length - 1;
    showBoxes.disabled = result.boxes.length == 0;
    preview.alt = `第 ${result.page} 页预览`;
    preview.onload = drawBoxes;
    preview.src = result.previewUrl;

    const chars = result.text.replace(/\s/g, '').length;
    pageStats.textContent = result.source == 'embedded'
      ? `第 ${result.page} 页 · PDF 内嵌文本 · ${chars} 字`
      : `第 ${result.page} 页 · OCR 置信度 ${Math.round(result.confidence || 0)}% · ${chars} 字`;
  }

  function renderResults() {
    workspace.hidden = false;
    output.value = combinedText();
    const charCount = output.value.replace(/\s/g, '').length;
    const ocrPages = results.filter((result) => result.source == 'ocr');
    const embeddedPages = results.length - ocrPages.length;
    const average = ocrPages.length
      ? Math.round(ocrPages.reduce((sum, result) => sum + (result.confidence || 0), 0) / ocrPages.length)
      : null;
    const parts = [`${results.length} 页`, `${charCount} 字`];
    if (ocrPages.length) parts.push(`OCR 平均 ${average}%`);
    if (embeddedPages) parts.push(`${embeddedPages} 页内嵌文本`);
    resultStats.textContent = parts.join(' · ');
    activePage = 0;
    renderActivePage();
  }

  async function run() {
    if (!selectedFile || busy) return;
    revokeResults();
    setMessage('');
    busy = true;
    cancelled = false;
    beginCancelScope();
    progressWrap.hidden = false;
    setProgress(0, '准备中…');
    updateButtons();

    try {
      if (isPdf(selectedFile)) await processPdf(selectedFile);
      else await processImage(selectedFile);
      if (cancelled) throw new CancelledError();
      setProgress(1, '识别完成');
      renderResults();
      setMessage('识别完成。结果仅供参考，重要内容请对照原件复核。', true);
    } catch (error) {
      revokeResults();
      await terminateWorker();
      if (cancelled || error instanceof CancelledError) {
        setMessage('已停止识别');
        progressWrap.hidden = true;
      } else {
        const detail = error instanceof Error ? error.message : String(error);
        setMessage(`识别失败：${detail}`);
        setProgress(0, '识别失败');
      }
    } finally {
      cancelSignal = null;
      resolveCancel = null;
      busy = false;
      updateButtons();
    }
  }

  fileInput.addEventListener('change', () => {
    chooseFile(fileInput.files?.[0] || null);
    fileInput.value = '';
  });

  drop.addEventListener('dragenter', (event) => {
    event.preventDefault();
    drop.classList.add('is-dragging');
  });
  drop.addEventListener('dragover', (event) => event.preventDefault());
  drop.addEventListener('dragleave', () => drop.classList.remove('is-dragging'));
  drop.addEventListener('drop', (event) => {
    event.preventDefault();
    drop.classList.remove('is-dragging');
    chooseFile(event.dataTransfer?.files?.[0] || null);
  });

  startBtn.addEventListener('click', run);
  clearBtn.addEventListener('click', clearFile);
  cancelBtn.addEventListener('click', async () => {
    if (!busy) return;
    cancelled = true;
    resolveCancel?.();
    cancelBtn.disabled = true;
    setProgress(progress.value, '正在停止…');
    await terminateWorker();
    cancelBtn.disabled = false;
  });

  prevBtn.addEventListener('click', () => {
    activePage = Math.max(0, activePage - 1);
    renderActivePage();
  });
  nextBtn.addEventListener('click', () => {
    activePage = Math.min(results.length - 1, activePage + 1);
    renderActivePage();
  });
  showBoxes.addEventListener('change', drawBoxes);

  copyBtn.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      setMessage('识别结果已复制', true);
    } catch {
      output.focus();
      output.select();
      setMessage('浏览器未允许自动复制，文字已选中，请按 Ctrl+C', false);
    }
  });

  downloadBtn.addEventListener('click', () => {
    if (!output.value || !selectedFile) return;
    const blob = new Blob(['\uFEFF', output.value], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${safeStem(selectedFile.name)}-OCR.txt`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1_000);
  });

  window.addEventListener('beforeunload', () => {
    for (const result of results) URL.revokeObjectURL(result.previewUrl);
    void terminateWorker();
  });

  updateButtons();
</script>
