---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="汉字拼音标注在线工具"
  description="中文自动标注拼音，支持声调符号与数字调，一键复制。适合课文、生词预习，本地处理。"
  currentSlug="pinyin"
>
  <h1 slot="header">拼音标注</h1>
  <p class="intro">粘贴或输入中文，自动标注拼音。可切换声调符号 / 数字调号，复制带拼音文本或仅拼音。</p>

  <div class="tool-panel">
    <label for="py-input">原文</label>
    <textarea id="py-input" class="json-editor tall-editor" placeholder="例如：轻工具箱，学好汉字。"></textarea>

    <div class="py-opts">
      <label><input type="radio" name="tone" value="symbol" checked /> 声调符号（hàn）</label>
      <label><input type="radio" name="tone" value="num" /> 数字调（han4）</label>
      <label><input type="radio" name="tone" value="none" /> 无调（han）</label>
    </div>

    <div class="btn-row">
      <button type="button" class="btn" id="btn-copy-ruby">复制带拼音</button>
      <button type="button" class="btn btn-secondary" id="btn-copy-py">复制仅拼音</button>
      <button type="button" class="btn btn-secondary" id="btn-clear">清空</button>
    </div>
    <div id="py-msg"></div>
  </div>

  <div class="tool-panel" style="margin-top:12px">
    <div class="field-label">预览</div>
    <div class="py-preview" id="py-preview" aria-live="polite"></div>
  </div>

  <p class="field-hint">
    相关：
    <a href="/tools/hanzi-write">汉字笔顺</a> ·
    <a href="/tools/word-count">字数统计</a>
  </p>

  <section class="section">
    <h2>使用说明</h2>
    <ul>
      <li>多音字按常见读音标注，专名或文言可能不准，请人工核对。</li>
      <li>全部在浏览器本地完成，文本不会上传。</li>
      <li>练笔顺可去「汉字笔顺」工具。</li>
    </ul>
  </section>
</ToolLayout>

<style>
  .py-opts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin: 10px 0;
  }
  .py-opts label {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-weight: 400;
  }
  .py-preview {
    min-height: 200px;
    padding: 8px 4px;
    line-height: 2.85;
    font-size: 1.85rem;
    word-break: break-word;
  }
  .py-preview ruby {
    ruby-align: center;
    margin: 0 3px;
  }
  .py-preview rt {
    font-size: 0.62em;
    line-height: 1.2;
    color: var(--muted, #555);
    font-family: var(--mono, ui-monospace, monospace);
    font-weight: 500;
  }
  .py-preview .img-meta {
    font-size: 0.95rem;
  }

  /* 手机：不用原生 ruby（过小且挤），改成拼音在上、汉字在下的字卡 */
  @media (max-width: 640px) {
    .tool-panel textarea.tall-editor {
      min-height: 110px;
    }
    .py-opts {
      gap: 8px;
    }
    .py-opts label {
      flex: 1 1 calc(50% - 8px);
      padding: 8px 10px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #fff;
      font-size: 0.92rem;
    }
    .btn-row .btn {
      flex: 1 1 calc(50% - 8px);
      min-height: 42px;
    }
    .py-preview {
      min-height: 220px;
      padding: 10px 6px 14px;
      font-size: 2.35rem;
      line-height: 1.45;
    }
    .py-preview ruby {
      display: inline-flex;
      flex-direction: column-reverse;
      align-items: center;
      justify-content: flex-end;
      vertical-align: top;
      min-width: 2.8em;
      margin: 6px 4px;
      padding: 8px 6px 6px;
      background: #fffef9;
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .py-preview rt {
      display: block;
      font-size: 0.95rem;
      line-height: 1.25;
      margin-bottom: 4px;
      font-weight: 600;
      color: var(--primary);
    }
  }
</style>

<script>
  import { pinyin } from 'pinyin-pro';

  const input = document.getElementById('py-input') as HTMLTextAreaElement;
  const preview = document.getElementById('py-preview')!;
  const msg = document.getElementById('py-msg')!;

  type ToneMode = 'symbol' | 'num' | 'none';

  function toneType(): ToneMode {
    const el = document.querySelector('input[name="tone"]:checked') as HTMLInputElement | null;
    return (el?.value as ToneMode) || 'symbol';
  }

  function toneOption() {
    const m = toneType();
    if (m == 'num') return 'num' as const;
    if (m == 'none') return 'none' as const;
    return true as const; // 符号调
  }

  function escapeHtml(s: string) {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function render() {
    const text = input.value;
    if (!text) {
      preview.innerHTML = '<span class="img-meta">输入后显示拼音预览</span>';
      return;
    }
    preview.innerHTML = buildRubyHtml(text, toneOption());
  }

  function buildRubyHtml(text: string, tone: true | 'num' | 'none') {
    const toneTypeOpt = tone == true ? 'symbol' : tone;
    const list = pinyin(text, {
      type: 'all',
      toneType: toneTypeOpt,
      nonZh: 'consecutive',
      v: true,
    }) as Array<{ origin: string; result: string; isZh: boolean }>;

    return list
      .map((item) => {
        if (item.origin == '\n') return '<br/>';
        if (item.isZh) {
          return `<ruby>${escapeHtml(item.origin)}<rt>${escapeHtml(item.result)}</rt></ruby>`;
        }
        return escapeHtml(item.origin).replace(/\n/g, '<br/>');
      })
      .join('');
  }

  function plainWithPinyin() {
    const tone = toneOption();
    const toneTypeOpt = tone == true ? 'symbol' : tone;
    const list = pinyin(input.value, {
      type: 'all',
      toneType: toneTypeOpt,
      nonZh: 'consecutive',
      v: true,
    }) as Array<{ origin: string; result: string; isZh: boolean }>;
    return list
      .map((item) => (item.isZh ? `${item.origin}(${item.result})` : item.origin))
      .join('');
  }

  function onlyPinyin() {
    const tone = toneOption();
    const toneTypeOpt = tone == true ? 'symbol' : tone;
    return pinyin(input.value, {
      toneType: toneTypeOpt,
      nonZh: 'consecutive',
      v: true,
      type: 'string',
      separator: ' ',
    }) as string;
  }

  async function copy(text: string, okMsg: string) {
    if (!text.trim()) return;
    await navigator.clipboard.writeText(text);
    msg.className = 'msg success';
    msg.textContent = okMsg;
  }

  input.addEventListener('input', render);
  document.querySelectorAll('input[name="tone"]').forEach((el) => {
    el.addEventListener('change', render);
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    input.value = '';
    msg.textContent = '';
    msg.className = '';
    render();
  });
  document.getElementById('btn-copy-ruby')!.addEventListener('click', () => copy(plainWithPinyin(), '已复制带拼音文本'));
  document.getElementById('btn-copy-py')!.addEventListener('click', () => copy(onlyPinyin(), '已复制拼音'));

  // 示例默认文案，方便首次打开看到效果
  if (!input.value) input.value = '轻工具箱，学好汉字。';
  render();
</script>
