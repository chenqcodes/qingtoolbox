---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="图片改尺寸与裁剪"
  description="图片改尺寸与裁剪在线工具，支持多图批量调整宽高、等比缩放、常用比例裁剪与 JPG、PNG、WebP 本地导出。"
  currentSlug="image-resize"
>
  <h1 slot="header">图片改尺寸</h1>
  <p class="intro">支持多图批量改尺寸与裁剪，统一设置宽高与比例，本地下载并保留原文件名。</p>

  <div class="compress-workspace batch-workspace resize-workspace" id="resize-wrap">
    <div class="compress-panel">
      <div class="field-label">原图（可多选）</div>
      <label class="img-slot img-slot-upload" id="resize-drop">
        <input type="file" id="resize-file" accept="image/*" multiple />
        <span id="resize-placeholder">点击或拖拽上传，可多选</span>
      </label>
      <div class="batch-grid cols-1" id="resize-src-grid"></div>
      <div class="img-meta" id="resize-meta">—</div>
    </div>

    <div class="compress-panel compress-controls">
      <div>
        <label class="field-label" for="resize-mode">处理方式</label>
        <select id="resize-mode">
          <option value="fit">改尺寸（完整保留）</option>
          <option value="crop">裁剪填充比例</option>
        </select>
      </div>

      <div>
        <label class="field-label" for="resize-preset">常用尺寸</label>
        <select id="resize-preset">
          <option value="custom">自定义</option>
          <option value="1:1">正方形 1:1</option>
          <option value="16:9">横图 16:9</option>
          <option value="4:3">横图 4:3</option>
          <option value="3:4">竖图 3:4</option>
          <option value="9:16">竖屏 9:16</option>
          <option value="avatar">头像 512×512</option>
          <option value="cover">封面 1280×720</option>
        </select>
      </div>

      <div class="size-input-row">
        <div>
          <label class="field-label" for="resize-w">宽 (px)</label>
          <input type="number" id="resize-w" min="1" placeholder="宽度" />
        </div>
        <div>
          <label class="field-label" for="resize-h">高 (px)</label>
          <input type="number" id="resize-h" min="1" placeholder="高度" />
        </div>
      </div>

      <label class="resize-check">
        <input type="checkbox" id="resize-lock" checked />
        <span>锁定比例</span>
      </label>

      <div>
        <label class="field-label" for="resize-format">输出格式</label>
        <select id="resize-format">
          <option value="image/jpeg">JPG</option>
          <option value="image/png">PNG</option>
          <option value="image/webp">WebP</option>
        </select>
      </div>

      <div>
        <label class="field-label">质量 <span class="range-val" id="resize-quality-val">92%</span></label>
        <div class="range-row">
          <input type="range" id="resize-quality" min="10" max="100" value="92" />
        </div>
      </div>

      <div class="btn-row compress-btn-row">
        <button class="btn" id="btn-resize" type="button">全部处理</button>
        <button class="btn btn-secondary" id="btn-resize-dl" type="button" hidden>批量下载</button>
        <button class="btn btn-secondary" id="btn-resize-clear" type="button" hidden>清空</button>
      </div>
      <div id="resize-msg"></div>
    </div>

    <div class="compress-panel">
      <div class="field-label">处理后（多图预览）</div>
      <div class="batch-grid cols-1" id="resize-out-grid">
        <span class="img-meta" style="grid-column:1/-1">等待处理</span>
      </div>
      <div class="img-meta" id="resize-out-meta">—</div>
    </div>
  </div>

  <section class="section">
    <h2>适合什么场景？</h2>
    <ul>
      <li>把图片改成指定宽高，比如网站上传、后台配图、文章封面。</li>
      <li>按 1:1、16:9、3:4、9:16 等比例居中裁剪。</li>
      <li>本地导出 JPG、PNG、WebP，图片不会上传服务器。</li>
    </ul>
  </section>
</ToolLayout>

<script>
  import {
    canvasToBlob,
    extFromMime,
    fmtSize,
    gridColsClass,
    loadImageFromFile,
    outputName,
    revokeItemUrls,
    zipAndDownload,
    type BatchItem,
  } from '../../scripts/image-batch';

  const wrap = document.getElementById('resize-wrap')!;
  const fileInput = document.getElementById('resize-file') as HTMLInputElement;
  const drop = document.getElementById('resize-drop')!;
  const srcGrid = document.getElementById('resize-src-grid')!;
  const outGrid = document.getElementById('resize-out-grid')!;
  const meta = document.getElementById('resize-meta')!;
  const outMeta = document.getElementById('resize-out-meta')!;
  const mode = document.getElementById('resize-mode') as HTMLSelectElement;
  const preset = document.getElementById('resize-preset') as HTMLSelectElement;
  const widthInput = document.getElementById('resize-w') as HTMLInputElement;
  const heightInput = document.getElementById('resize-h') as HTMLInputElement;
  const lock = document.getElementById('resize-lock') as HTMLInputElement;
  const format = document.getElementById('resize-format') as HTMLSelectElement;
  const quality = document.getElementById('resize-quality') as HTMLInputElement;
  const qualityVal = document.getElementById('resize-quality-val')!;
  const btnDl = document.getElementById('btn-resize-dl') as HTMLButtonElement;
  const btnClear = document.getElementById('btn-resize-clear') as HTMLButtonElement;
  const msg = document.getElementById('resize-msg')!;

  let items: BatchItem[] = [];
  let activeId = '';
  let lockRatioW = 0;
  let lockRatioH = 0;
  let debounceTimer: ReturnType<typeof setTimeout>;

  function showMsg(text: string, type: 'error' | 'success') {
    msg.className = `msg ${type}`;
    msg.textContent = text;
  }

  function setSize(w: number, h: number) {
    widthInput.value = String(Math.max(1, Math.round(w)));
    heightInput.value = String(Math.max(1, Math.round(h)));
  }

  function getOutSize(fallbackW: number, fallbackH: number) {
    const outW = Math.max(1, Math.round(Number(widthInput.value) || fallbackW));
    const outH = Math.max(1, Math.round(Number(heightInput.value) || fallbackH));
    return { w: outW, h: outH };
  }

  function drawSource(
    ctx: CanvasRenderingContext2D,
    img: HTMLImageElement,
    origW: number,
    origH: number,
    outW: number,
    outH: number,
  ) {
    if (mode.value == 'fit') {
      ctx.drawImage(img, 0, 0, outW, outH);
      return;
    }
    const scale = Math.max(outW / origW, outH / origH);
    const cropW = outW / scale;
    const cropH = outH / scale;
    const cropX = (origW - cropW) / 2;
    const cropY = (origH - cropH) / 2;
    ctx.drawImage(img, cropX, cropY, cropW, cropH, 0, 0, outW, outH);
  }

  function setGridClass(el: HTMLElement, n: number) {
    el.className = `batch-grid ${gridColsClass(n)}`;
  }

  function renderGrids() {
    wrap.classList.toggle('has-files', items.length > 0);
    setGridClass(srcGrid, items.length);
    setGridClass(outGrid, items.length || 1);

    srcGrid.innerHTML = items.map((it) => {
      const st = it.status == 'done' ? '完成' : it.status == 'error' ? '失败' : '待处理';
      const cls = [
        'batch-thumb',
        it.id == activeId ? 'is-active' : '',
        it.status == 'done' ? 'is-done' : '',
        it.status == 'error' ? 'is-error' : '',
      ].filter(Boolean).join(' ');
      return `<button type="button" class="${cls}" data-id="${it.id}">
        <img src="${it.srcUrl || ''}" alt="" />
        <span class="batch-thumb-st">${st}</span>
        <span class="batch-thumb-cap">${it.file.name}</span>
      </button>`;
    }).join('');

    const done = items.filter((i) => i.status == 'done' && i.previewUrl);
    if (!items.length) {
      outGrid.innerHTML = '<span class="img-meta" style="grid-column:1/-1">等待处理</span>';
    } else if (!done.length) {
      outGrid.innerHTML = '<span class="img-meta" style="grid-column:1/-1">处理中…</span>';
    } else {
      outGrid.innerHTML = items.map((it) => {
        if (it.status != 'done' || !it.previewUrl) {
          return `<div class="batch-thumb is-error" data-id="${it.id}">
            <span class="batch-thumb-st">${it.status == 'error' ? '失败' : '…'}</span>
            <span class="batch-thumb-cap">${it.file.name}</span>
          </div>`;
        }
        const cls = `batch-thumb is-done${it.id == activeId ? ' is-active' : ''}`;
        return `<button type="button" class="${cls}" data-id="${it.id}">
          <img src="${it.previewUrl}" alt="" />
          <span class="batch-thumb-st">完成</span>
          <span class="batch-thumb-cap">${it.outName || it.file.name}</span>
        </button>`;
      }).join('');
    }

    meta.textContent = items.length ? `共 ${items.length} 张` : '—';
    const active = items.find((i) => i.id == activeId && i.status == 'done');
    outMeta.textContent = active?.blob
      ? `${active.outName} · ${fmtSize(active.blob.size)}${active.meta ? ` · ${active.meta}` : ''}`
      : (done.length ? `已完成 ${done.length}/${items.length}` : '—');
    btnClear.hidden = items.length == 0;
    btnDl.hidden = done.length == 0;
  }

  async function resizeOne(it: BatchItem) {
    const img = await loadImageFromFile(it.file);
    const { w: outW, h: outH } = getOutSize(img.width, img.height);
    const canvas = document.createElement('canvas');
    canvas.width = outW;
    canvas.height = outH;
    const ctx = canvas.getContext('2d')!;
    if (format.value == 'image/jpeg') {
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, outW, outH);
    } else {
      ctx.clearRect(0, 0, outW, outH);
    }
    drawSource(ctx, img, img.width, img.height, outW, outH);
    const mime = format.value;
    const q = Number(quality.value) / 100;
    const blob = await canvasToBlob(canvas, mime, q);
    const ext = extFromMime(mime);
    if (it.previewUrl) URL.revokeObjectURL(it.previewUrl);
    it.blob = blob;
    it.outName = outputName(it.file.name, ext, `-${outW}x${outH}`);
    it.previewUrl = URL.createObjectURL(blob);
    it.status = 'done';
    it.meta = `${outW}×${outH} · ${mode.value == 'crop' ? '裁剪' : '缩放'}`;
  }

  async function resizeAll() {
    if (!items.length) {
      showMsg('请先上传图片', 'error');
      return;
    }
    showMsg('处理中…', 'success');
    for (const it of items) {
      it.status = 'pending';
      try {
        await resizeOne(it);
      } catch {
        it.status = 'error';
        it.error = '失败';
      }
      renderGrids();
    }
    if (!activeId || !items.find((i) => i.id == activeId && i.status == 'done')) {
      activeId = items.find((i) => i.status == 'done')?.id || '';
    }
    renderGrids();
    const ok = items.filter((i) => i.status == 'done').length;
    showMsg(`完成 ${ok}/${items.length}`, ok ? 'success' : 'error');
  }

  function scheduleResize() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(resizeAll, 280);
  }

  async function initSizeFromFile(file: File) {
    const img = await loadImageFromFile(file);
    setSize(img.width, img.height);
    lockRatioW = img.width;
    lockRatioH = img.height;
    lock.checked = true;
    preset.value = 'custom';
    mode.value = 'fit';
  }

  function applyPreset() {
    const value = preset.value;
    if (value == 'custom') return;
    if (value == 'avatar') {
      setSize(512, 512);
      mode.value = 'crop';
      lock.checked = false;
      resizeAll();
      return;
    }
    if (value == 'cover') {
      setSize(1280, 720);
      mode.value = 'crop';
      lock.checked = false;
      resizeAll();
      return;
    }
    const [rw, rh] = value.split(':').map(Number);
    const base = lockRatioW > 0 ? Math.min(lockRatioW, 1280) : 1280;
    setSize(base, Math.round(base * rh / rw));
    mode.value = 'crop';
    lock.checked = false;
    resizeAll();
  }

  async function addFiles(files: FileList | File[]) {
    const arr = Array.from(files).filter((f) => f.type.startsWith('image/'));
    const isFirst = items.length == 0;
    for (const file of arr) {
      items.push({
        id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
        file,
        status: 'pending',
        srcUrl: URL.createObjectURL(file),
      });
    }
    if (!activeId && items.length) activeId = items[0].id;
    if (isFirst && arr.length) {
      try {
        await initSizeFromFile(arr[0]);
      } catch {
        showMsg('图片读取失败', 'error');
      }
    }
    renderGrids();
    resizeAll();
  }

  function onGridClick(e: Event) {
    const btn = (e.target as HTMLElement).closest('[data-id]') as HTMLElement | null;
    if (!btn?.dataset.id) return;
    activeId = btn.dataset.id;
    renderGrids();
  }
  srcGrid.addEventListener('click', onGridClick);
  outGrid.addEventListener('click', onGridClick);

  fileInput.addEventListener('change', () => {
    if (fileInput.files?.length) addFiles(fileInput.files);
    fileInput.value = '';
  });
  drop.addEventListener('dragover', (e) => e.preventDefault());
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer?.files?.length) addFiles(e.dataTransfer.files);
  });

  widthInput.addEventListener('input', () => {
    if (lock.checked && lockRatioW && lockRatioH) {
      const w = Number(widthInput.value);
      if (w > 0) heightInput.value = String(Math.round(lockRatioH * (w / lockRatioW)));
    }
    preset.value = 'custom';
    scheduleResize();
  });

  heightInput.addEventListener('input', () => {
    if (lock.checked && lockRatioW && lockRatioH) {
      const h = Number(heightInput.value);
      if (h > 0) widthInput.value = String(Math.round(lockRatioW * (h / lockRatioH)));
    }
    preset.value = 'custom';
    scheduleResize();
  });

  preset.addEventListener('change', applyPreset);
  mode.addEventListener('change', resizeAll);
  format.addEventListener('change', resizeAll);
  quality.addEventListener('input', () => {
    qualityVal.textContent = quality.value + '%';
    scheduleResize();
  });
  document.getElementById('btn-resize')!.addEventListener('click', resizeAll);
  btnDl.addEventListener('click', async () => {
    const done = items.filter((i) => i.status == 'done' && i.blob && i.outName)
      .map((i) => ({ name: i.outName!, blob: i.blob! }));
    await zipAndDownload(done, 'resized-images.zip');
  });
  btnClear.addEventListener('click', () => {
    items.forEach(revokeItemUrls);
    items = [];
    activeId = '';
    lockRatioW = 0;
    lockRatioH = 0;
    widthInput.value = '';
    heightInput.value = '';
    preset.value = 'custom';
    renderGrids();
    msg.textContent = '';
    msg.className = '';
  });
</script>
