---
import BaseLayout from './BaseLayout.astro';
import tools from '../data/tools.json';
import categories from '../data/categories.json';
interface Props { title: string; description: string; currentSlug: string; }
const { title, description, currentSlug } = Astro.props;

function toolHref(t: { slug: string; path?: string }) {
  return t.path || `/tools/${t.slug}`;
}
---

<BaseLayout title={title} description={description} wide={true}>
  <div class="tool-layout">
    <article class="tool-main tool-page">
      <div class="tool-switcher">
        <a class="tool-switcher-home" href="/">全部工具</a>
        <label class="tool-switcher-label" for="tool-switch-select">
          <span class="visually-hidden">切换工具</span>
          <select id="tool-switch-select" class="tool-switch-select">
            {categories.map((category) => (
              <optgroup label={category.name}>
                {tools.filter((t) => t.category == category.id).map((t) => (
                  <option value={toolHref(t)} selected={t.slug == currentSlug}>{t.name}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </label>
      </div>
      <slot name="header" />
      <slot />
    </article>
  </div>
</BaseLayout>

<script>
  const sel = document.getElementById('tool-switch-select') as HTMLSelectElement | null;
  sel?.addEventListener('change', () => {
    if (sel.value) location.href = sel.value;
  });
</script>
