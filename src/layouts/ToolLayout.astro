---
import BaseLayout from './BaseLayout.astro';
import tools from '../data/tools.json';
import categories from '../data/categories.json';
interface Props { title: string; description: string; currentSlug: string; }
const { title, description, currentSlug } = Astro.props;

function toolHref(t: { slug: string; path?: string }) {
  return t.path || `/tools/${t.slug}`;
}

const currentTool = tools.find((tool) => tool.slug === currentSlug);
const currentCategory = categories.find((category) => category.id === currentTool?.category);
---

<BaseLayout title={title} description={description} wide={true}>
  <div class="tool-layout">
    <article class="tool-main tool-page">
      <nav class="tool-switcher" aria-label="工具导航">
        <a class="tool-switcher-home" href="/">
          <span aria-hidden="true">←</span><span>全部工具</span>
        </a>
        <span class="tool-switcher-separator" aria-hidden="true">&gt;</span>
        <details class="tool-switcher-menu">
          <summary>
            <span>{currentCategory?.name || '全部分类'} · 切换工具</span>
            <svg class="tool-switcher-chevron" viewBox="0 0 12 12" aria-hidden="true">
              <path d="m3 4.5 3 3 3-3"></path>
            </svg>
          </summary>
          <div class="tool-switcher-popover">
            {categories.map((category) => (
              <div class="tool-switcher-group">
                <span class="tool-switcher-group-title">{category.name}</span>
                <div class="tool-switcher-list">
                  {tools.filter((tool) => tool.category === category.id).map((tool) => (
                    <a
                      href={toolHref(tool)}
                      aria-current={tool.slug === currentSlug ? 'page' : undefined}
                    >
                      {tool.name}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </details>
      </nav>
      <slot name="header" />
      <slot />
    </article>
  </div>
</BaseLayout>

<script>
  const switcher = document.querySelector<HTMLDetailsElement>('.tool-switcher-menu');

  document.addEventListener('click', (event) => {
    if (switcher?.open && event.target instanceof Node && !switcher.contains(event.target)) {
      switcher.removeAttribute('open');
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && switcher?.open) {
      switcher.removeAttribute('open');
      switcher.querySelector<HTMLElement>('summary')?.focus();
    }
  });
</script>
