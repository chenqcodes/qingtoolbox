{
  "name": "qingtoolbox",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "astro check",
    "check:labs": "node --import tsx src/scripts/astro-today/self-check.ts && node --import tsx src/scripts/orbit-lab/self-check.ts && node --import tsx src/scripts/sat-pass/self-check.ts && node --import tsx src/scripts/molecule/self-check.ts && node --import tsx src/scripts/audio-viz/self-check.ts && node --import tsx src/scripts/invisible-chars/self-check.ts",
    "seo:fetch-gsc": "tsx scripts/seo/fetch-gsc.ts",
    "seo:fetch-bing": "tsx scripts/seo/fetch-bing.ts",
    "seo:keyword-hints": "tsx scripts/seo/keyword-hints.ts",
    "seo:analyze": "tsx scripts/seo/analyze-gsc.ts",
    "seo:daily-report": "tsx scripts/seo/daily-report.ts",
    "seo:auto-optimize": "tsx scripts/seo/auto-optimize.ts",
    "qa:links": "tsx scripts/qa/check-links.ts",
    "qa:metadata": "tsx scripts/qa/check-metadata.ts",
    "qa:seo": "node --import tsx scripts/qa/check-seo.ts",
    "test:seo": "node --import tsx --test scripts/seo/*.test.ts",
    "test:tools": "node --import tsx --test src/scripts/image-compress*.test.ts src/scripts/hanzi-worksheet/*.test.ts",
    "test:browser": "playwright test",
    "test:science": "node --import tsx --test src/scripts/audio-viz/*.test.ts src/scripts/molecule/*.test.ts src/scripts/space/*.test.ts public/vendor/building-sunlight/tests/*.test.js"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.4.0",
    "@types/qrcode": "^1.5.6",
    "astro": "^5.7.10",
    "astronomy-engine": "^2.1.19",
    "exifr": "^7.1.3",
    "fabric": "^5.3.0",
    "hanzi-writer": "^3.7.3",
    "js-md5": "^0.8.3",
    "jsonrepair": "^3.12.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pinyin-pro": "^3.28.2",
    "qrcode": "^1.5.4",
    "satellite.js": "^6.0.2",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "vanilla-jsoneditor": "^3.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "1.58.2",
    "@types/fabric": "^5.3.0",
    "@types/three": "^0.185.1",
    "googleapis": "^148.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
